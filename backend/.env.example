# Copy to backend/.env to override. MotorScope needs no secrets or API keys.

# "development" enables /docs and /openapi.json. Anything else is treated as production.
APP_ENV=production

# Frontend origins allowed to call the API (comma separated, exact match).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host headers the API answers to. Add your public API hostname in production.
ALLOWED_HOSTS=localhost,127.0.0.1

MAX_UPLOAD_MB=50
RATE_LIMIT_PER_MIN=20
MAX_CONCURRENT_ANALYSES=2

# Who may embed the site in a frame. 'none' blocks framing; a host that shows the app
# inside its own page (e.g. Hugging Face Spaces) needs its origin, e.g. 'self' https://huggingface.co
FRAME_ANCESTORS='none'

# Only enable when the API is served over HTTPS.
ENABLE_HSTS=false

# Set to the built frontend (frontend/dist) to serve the site at / and the API under /api.
# FRONTEND_DIST=../frontend/dist
